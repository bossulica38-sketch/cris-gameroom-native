<Window x:Class="CrisGameRoom.Views.CreateTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creează o tablă nouă" Width="760" Height="560"
        MinWidth="600" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeSurfaceBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="26" FontWeight="Bold" Text="Alege jocul pentru tablă"/>
            <TextBlock x:Name="VisibilityText" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold"
                       Text="Tabla va fi publică. Ctrl+H schimbă vizibilitatea în privată."
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ListBox x:Name="GamesList" Grid.Row="1" MinHeight="220" DisplayMemberPath="Name"
                 SelectionMode="Single" SelectionChanged="GamesList_SelectionChanged"
                 AutomationProperties.Name="Jocuri disponibile pentru crearea unei table"
                 AutomationProperties.HelpText="Alege un joc activ. Apasă Enter pentru a crea tabla."/>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Înapoi" MinWidth="120" MinHeight="44" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button x:Name="CreateButton" Content="Creează tabla" MinWidth="160" MinHeight="44" IsDefault="True" Click="CreateButton_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
