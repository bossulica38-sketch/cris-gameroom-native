<Window x:Class="CrisGameRoom.Views.CreateTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creează o tablă nouă"
        Width="680" Height="520" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeSurfaceBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="WindowHeading" Grid.Row="0" FontSize="26" FontWeight="Bold" Text="Creează o tablă nouă" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="NameLabel" Text="Numele tablei" FontSize="15"/>
            <TextBox x:Name="NameInput" MinHeight="42" FontSize="16" Padding="8" Margin="0,6,0,16" AutomationProperties.Name="Numele tablei"/>
            <TextBlock x:Name="DescriptionLabel" Text="Descriere" FontSize="15"/>
            <TextBox x:Name="DescriptionInput" MinHeight="90" FontSize="16" Padding="8" Margin="0,6,0,16" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descrierea tablei"/>
            <TextBlock x:Name="PlayersLabel" Text="Număr maxim de jucători" FontSize="15"/>
            <ComboBox x:Name="MaxPlayersInput" MinHeight="42" FontSize="16" Padding="8" Margin="0,6,0,16" SelectedIndex="1" AutomationProperties.Name="Număr maxim de jucători">
                <ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="6" Tag="6"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="10" Tag="10"/><ComboBoxItem Content="20" Tag="20"/>
            </ComboBox>
            <TextBlock x:Name="VisibilityText" Text="PUBLICĂ" FontSize="18" FontWeight="Bold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="ErrorText" FontSize="14" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Anulează" MinWidth="120" MinHeight="44" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="CreateButton" Content="Creează" MinWidth="140" MinHeight="44" IsDefault="True" Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
