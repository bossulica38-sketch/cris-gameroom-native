<Window x:Class="CrisGameRoom.Views.RoomTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabla de joc"
        Width="1180"
        Height="790"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Loaded="RoomTableWindow_Loaded"
        Closing="RoomTableWindow_Closing"
        Closed="RoomTableWindow_Closed"
        PreviewKeyDown="RoomTableWindow_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="RoomNameText"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="Tabla de joc"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="RoomSummaryText"
                       Margin="0,8,0,0"
                       FontSize="15"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="RoomStatusText"
                       Margin="0,5,0,0"
                       FontSize="15"
                       AutomationProperties.LiveSetting="Polite"/>

            <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="BotLevelLabel" Text="Nivel adversar AI"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           AutomationProperties.Name="Nivel adversar AI"/>
                <ComboBox x:Name="BotLevelCombo"
                          Width="240"
                          MinHeight="42"
                          Margin="0,0,8,0"
                          Padding="8"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Nivel adversar AI"
                          AutomationProperties.HelpText="Alege nivelul de dificultate încărcat din baza de date."/>

                <Button x:Name="AddBotButton"
                        Click="AddBotButton_Click"
                        AutomationProperties.Name="Adaugă un adversar AI. Scurtătură B."
                        AutomationProperties.HelpText="Adaugă un adversar din nivelul selectat.">
                    Adaugă adversar AI (B)
                </Button>

                <Button x:Name="RemoveBotButton"
                        Click="RemoveBotButton_Click"
                        AutomationProperties.Name="Elimină ultimul adversar AI. Scurtătură Shift+B."
                        AutomationProperties.HelpText="Elimină ultimul adversar AI adăugat.">
                    Elimină ultimul (Shift+B)
                </Button>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="PlayersGroup"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Header="Jucătorii de pe tablă">
                <ListBox x:Name="PlayersList"
                         Margin="8"
                         AutomationProperties.Name="Jucătorii de pe tablă"
                         AutomationProperties.HelpText="Folosește săgețile pentru a naviga prin lista jucătorilor."/>
            </GroupBox>


        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LiveStatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>

            <Button x:Name="RefreshRoomButton"
                    Grid.Column="1"
                    Click="RefreshRoomButton_Click"
                    AutomationProperties.Name="Reîmprospătează tabla">
                Reîmprospătează tabla
            </Button>

            <Button x:Name="LeaveRoomButton"
                    Grid.Column="2"
                    Click="LeaveRoomButton_Click"
                    AutomationProperties.Name="Părăsește tabla">
                Părăsește tabla
            </Button>
        </Grid>
    </Grid>
</Window>
