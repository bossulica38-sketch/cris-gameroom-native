<Window x:Class="CrisGameRoom.Views.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="http://schemas.microsoft.com/winfx/2006/automation" Title="Opțiuni" Width="1120" Height="780" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
<Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="OPȚIUNI" FontSize="19" FontWeight="Bold" Margin="4,4,4,12"/>
<ListBox x:Name="OptionsMenu" SelectionChanged="OptionsMenu_SelectionChanged" AutomationProperties.Name="Meniul opțiunilor" KeyboardNavigation.TabNavigation="Once">
<ListBoxItem Content="Limba" Tag="language"/><ListBoxItem Content="Opțiuni generale" Tag="general"/><ListBoxItem Content="Audio și text-to-speech" Tag="audio"/><ListBoxItem Content="Citire și aspect" Tag="reading"/><ListBoxItem Content="Securitate" Tag="security"/><ListBoxItem Content="Confidențialitate" Tag="privacy"/><ListBoxItem Content="Restabilește setările implicite" Tag="defaults"/><ListBoxItem Content="Înapoi" Tag="back"/>
</ListBox></DockPanel></Border>
<Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock x:Name="PageTitle" FontSize="25" FontWeight="Bold" Text="Opțiuni"/><TextBlock x:Name="PageDescription" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsBody"/></ScrollViewer></DockPanel></Border>
</Grid></Window>
