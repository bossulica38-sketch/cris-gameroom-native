<Window x:Class="CrisGameRoom.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jocuri și Discuții" Width="520" Height="650" MinWidth="460" MinHeight="600" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="{DynamicResource ThemeSurfaceBrush}" Loaded="LoginWindow_Loaded">
<Grid Margin="38"><Grid.RowDefinitions>
<RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="46"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="46"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="50"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="JOCURI ȘI DISCUȚII" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" AutomationProperties.Name="Jocuri și Discuții"/>
<TextBlock x:Name="IdentifierLabel" Grid.Row="2" Text="Nume utilizator" FontSize="16" FontWeight="SemiBold"/>
<TextBox x:Name="IdentifierTextBox" Grid.Row="4" FontSize="17" Padding="10,7" AutomationProperties.Name="Nume utilizator" AutomationProperties.HelpText="Introduceți numele de utilizator"/>
<TextBlock x:Name="PasswordLabel" Grid.Row="6" Text="Parolă" FontSize="16" FontWeight="SemiBold"/>
<PasswordBox x:Name="PasswordBox" Grid.Row="8" FontSize="17" Padding="10,7" AutomationProperties.Name="Parolă" AutomationProperties.HelpText="Introduceți parola"/>
<StackPanel Grid.Row="10" Margin="0,0,0,10"><TextBlock x:Name="LanguageLabel" Text="Limbă" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="LanguageComboBox" MinHeight="36" FontSize="15" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageComboBox_SelectionChanged" AutomationProperties.Name="Limba aplicației"/></StackPanel>
<StackPanel Grid.Row="12"><CheckBox x:Name="RememberCredentialsCheckBox" Content="Reține parola" IsChecked="True" FontSize="15" Margin="0,0,0,10" AutomationProperties.Name="Reține parola"/><CheckBox x:Name="AutoLoginCheckBox" Content="Autentificare automată la pornire" IsChecked="True" FontSize="15" AutomationProperties.Name="Autentificare automată la pornire" Checked="AutoLoginCheckBox_Changed" Unchecked="AutoLoginCheckBox_Changed"/></StackPanel>
<Button x:Name="ConnectButton" Grid.Row="14" Content="Conectare" FontSize="17" FontWeight="Bold" IsDefault="True" Click="ConnectButton_Click" AutomationProperties.Name="Conectare"/>
<Button x:Name="ForgotPasswordButton" Grid.Row="16" Content="Ai uitat parola?" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Click="ForgotPasswordButton_Click" AutomationProperties.Name="Ai uitat parola?"/>
<Button x:Name="CreateAccountButton" Grid.Row="18" Content="Creează cont" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Click="CreateAccountButton_Click" AutomationProperties.Name="Creează cont"/>
<Button x:Name="AboutButton" Grid.Row="20" Content="Despre" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Click="AboutButton_Click" AutomationProperties.Name="Despre"/>
<Button x:Name="StatusButton" Grid.Row="22" Content="Starea serviciului" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Click="StatusButton_Click" AutomationProperties.Name="Starea serviciului"/>
<Button x:Name="ExitButton" Grid.Row="24" Content="Ieșire" HorizontalAlignment="Center" Click="ExitButton_Click" AutomationProperties.Name="Ieșire"/>
</Grid></Window>
