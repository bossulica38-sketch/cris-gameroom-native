<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrisGameRoom.Views.MainWindow" Title="Jocuri în Camera" Width="1100" Height="750" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded" Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="8" />
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid x:Name="CrisDashboardChrome" Background="{DynamicResource ThemeSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CrisDashboardHeader}" AutomationProperties.Name="Antet CRIS GAMEROOM">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="CrisAppLogo" Style="{StaticResource CrisLogoMark}" Width="44" Height="44" AutomationProperties.Name="Logo CRIS GAMEROOM">
                    <TextBlock Text="C" Foreground="{StaticResource ThemeTextBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="CRIS GAMEROOM" Style="{StaticResource CrisBrandTitle}" />
                    <TextBlock Text="Jocuri și discuții" Style="{StaticResource CrisBrandSubtitle}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource CrisStatusBadge}">
                    <TextBlock Text="APLICAȚIE DESKTOP" Foreground="{StaticResource ThemeTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="22,8,22,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border Style="{StaticResource CrisPanel}" Padding="16">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold" Text="Camera de joc" />
                            <TextBlock x:Name="UserText" Margin="0,8,0,0" FontSize="17" Text="Conectat" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="14,8" Margin="20,0,0,0" BorderThickness="1" CornerRadius="8">
                            <TextBlock x:Name="ConnectionText" FontSize="15" Text="Se conectează..." />
                        </Border>
                    </Grid>
                    <Separator Grid.Row="1" Margin="0,22,0,22" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <Button x:Name="CreateTableButton" AutomationProperties.Name="Creează o tablă nouă" Click="CreateTableButton_Click" Style="{StaticResource CrisPrimaryButton}">
                    Creează o tablă nouă
                </Button>
                            <Button x:Name="JoinTableButton" AutomationProperties.Name="Intră într-o tablă" Click="JoinTableButton_Click" Style="{StaticResource CrisPrimaryButton}">
                    Intră într-o tablă
                </Button>
                            <Button x:Name="RestoreTableButton" AutomationProperties.Name="Restabilește o tablă" Click="RestoreTableButton_Click">
                    Restabilește o tablă
                </Button>
                            <Button x:Name="MyTablesButton" AutomationProperties.Name="Tablele mele" Click="MyTablesButton_Click">
                    Tablele mele
                </Button>
                            <Button x:Name="OptionsButton" AutomationProperties.Name="Opțiuni" Click="OptionsButton_Click">
                    Opțiuni
                </Button>
                            <Button x:Name="FeaturesButton" AutomationProperties.Name="Funcții și altele" Click="FeaturesButton_Click">
                    Funcții și altele
                </Button>
                            <Button x:Name="HelpButton" AutomationProperties.Name="Ajutor" Click="HelpButton_Click">
                    Ajutor
                </Button>
                            <Button x:Name="StatusButton" AutomationProperties.Name="Status și servicii" Click="StatusButton_Click">
                    Status și servicii
                </Button>
                        </UniformGrid>
                    </ScrollViewer>
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VersionText" VerticalAlignment="Center" FontSize="14" Text="Jocuri în Camera" />
                            <Button Grid.Column="1" x:Name="ExitGameRoomButton" AutomationProperties.Name="Ieși din camera de joc" MinHeight="48" MinWidth="220" Margin="8,0,0,0" FontSize="16" Click="ExitGameRoomButton_Click">
                    Ieși din camera de joc
                </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
