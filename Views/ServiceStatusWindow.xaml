<Window x:Class="CrisGameRoom.Views.ServiceStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Starea serviciului" Width="760" Height="620" MinWidth="560" MinHeight="440" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemeSurfaceBrush}" Loaded="Window_Loaded">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" x:Name="StatusTitleText" Text="Starea serviciului CRIS GameRoom" FontSize="25" FontWeight="Bold" AutomationProperties.Name="Starea serviciului CRIS GameRoom"/>
<StackPanel Grid.Row="2"><TextBlock x:Name="LastCheckedText" Text="Se verifică serviciile..." FontSize="14"/><TextBlock x:Name="PlatformStatusText" Text="Platformă: verificare în curs" Margin="0,5,0,0"/><TextBlock x:Name="ApiStatusText" Text="Serviciul de conectare: verificare în curs" Margin="0,5,0,0"/><TextBlock x:Name="UpdatesStatusText" Text="Actualizări: verificare în curs" Margin="0,5,0,0"/></StackPanel>
<GroupBox Grid.Row="4" Header="Noutăți și anunțuri" FontSize="16" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True"><StackPanel><TextBlock Text="Anunțuri CRIS GameRoom" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="AnnouncementsText" TextWrapping="Wrap" FontSize="15" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Noutăți și anunțuri" Text="Nu există momentan anunțuri noi. Aici vor apărea informații despre versiuni noi, lucrări de mentenanță, întreruperi și alte noutăți ale platformei."/></StackPanel></ScrollViewer></GroupBox>
<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RefreshButton" Content="Verifică din nou" MinWidth="140" Margin="0,0,10,0" Click="RefreshButton_Click" AutomationProperties.Name="Verifică din nou"/><Button Content="Închide" MinWidth="100" IsCancel="True" AutomationProperties.Name="Închide"/></StackPanel>
</Grid></Window>
