<Window x:Class="CrisGameRoom.Views.JoinTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intră într-o tablă"
        Width="900"
        Height="660"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Loaded="JoinTableWindow_Loaded"
        PreviewKeyDown="JoinTableWindow_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="Intră într-o tablă"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,8,0,12"
                       FontSize="16"
                       Text="Alege o tablă accesibilă de pe platformă."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,0,0,12"
                   FontSize="15"
                   AutomationProperties.LiveSetting="Polite"
                   Text="Se încarcă tablele..."/>

        <ListView x:Name="RoomsList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  SelectionChanged="RoomsList_SelectionChanged"
                  MouseDoubleClick="RoomsList_MouseDoubleClick"
                  AutomationProperties.Name="Lista tablelor accesibile"
                  AutomationProperties.HelpText="Selectează o tablă și folosește butonul pentru a intra.">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1"
                            Padding="10"
                            Margin="0,2"
                            AutomationProperties.Name="{Binding AccessibleSummary}">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}"
                                       FontSize="14"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    AutomationProperties.Name="Reîmprospătează lista">
                Reîmprospătează lista
            </Button>
            <Button x:Name="EnterButton"
                    Click="EnterButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Intră în tabla selectată">
                Intră în tabla selectată
            </Button>
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    AutomationProperties.Name="Înapoi">
                Înapoi
            </Button>
        </StackPanel>
    </Grid>
</Window>
