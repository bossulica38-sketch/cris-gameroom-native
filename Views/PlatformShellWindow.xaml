<Window x:Class="CrisGameRoom.Views.PlatformShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="http://schemas.microsoft.com/winfx/2006/automation"
        Title="CRIS GAMEROOM — Platformă"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurfaceBrush}"
        Foreground="{DynamicResource ThemeTextBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="PlatformNavigationItem"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="2,2,2,4"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="AutomationProperties.IsOffscreenBehavior"
                    Value="Onscreen"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemePressedBrush}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot"
          Background="{DynamicResource ThemeSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="10"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="2"
                        Background="{DynamicResource ThemeSurfaceBrush}">
                    <TextBlock Text="C"
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="CRIS GAMEROOM"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,18,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="CRIS GAMEROOM"
                               Style="{DynamicResource CrisBrandTitle}"/>
                    <TextBlock Text="Jocuri și discuții"
                               Style="{DynamicResource CrisBrandSubtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionText"
                               Text="Versiunea aplicației"
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="Se verifică legătura cu serverul..."
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{DynamicResource CrisPanel}"
                    Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="6,2,6,12">
                        <TextBlock Text="MENIUL PLATFORMEI"
                                   Foreground="{DynamicResource ThemeTextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Folosește săgețile sus și jos. Apasă Enter pentru a deschide."
                                   Foreground="{DynamicResource ThemeTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="NavigationMenu"
                             SelectionMode="Single"
                             SelectedIndex="0"
                             BorderThickness="0"
                             Background="{DynamicResource ThemeSurfaceBrush}"
                             Foreground="{DynamicResource ThemeTextBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once"
                             SelectionChanged="NavigationMenu_SelectionChanged"
                             automation:AutomationProperties.Name="Meniul principal CRIS GAMEROOM"
                             automation:AutomationProperties.HelpText="Navighează cu săgețile sus și jos. Apasă Enter pentru a selecta intrarea."
                             Focusable="True">
                        <ListBoxItem Tag="create" Content="Creează o tablă nouă"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Creează o tablă nouă"/>
                        <ListBoxItem Tag="join" Content="Intră într-o tablă"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Intră într-o tablă"/>
                        <ListBoxItem Tag="restore" Content="Restaurează o tablă"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Restaurează o tablă"/>
                        <ListBoxItem Tag="options" Content="Opțiuni"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Opțiuni"/>
                        <ListBoxItem Tag="features" Content="Funcții și altele"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Funcții și altele"/>
                        <ListBoxItem Tag="leave" Content="Părăsește camera de joc"
                                     Style="{StaticResource PlatformNavigationItem}"
                                     automation:AutomationProperties.Name="Părăsește camera de joc"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CrisPanel}"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle"
                                   Text="Meniul principal"
                                   Style="{DynamicResource CrisPageTitle}"/>
                        <TextBlock x:Name="PageDescription"
                                   Text="Selectează una dintre cele șase secțiuni. Conținutul lor va fi configurat separat."
                                   Foreground="{DynamicResource ThemeTextBrush}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>
                        <StackPanel x:Name="PageBody"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,9">
            <TextBlock Text="CRIS GAMEROOM · Meniu de navigare · Săgeți sus/jos pentru selectare · Enter pentru activare"
                       Foreground="{DynamicResource ThemeTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
