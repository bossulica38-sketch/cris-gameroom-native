<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CrisGameRoomUpdater</AssemblyName>
    <RootNamespace>CrisGameRoomUpdater</RootNamespace>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
      <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>Cris GameRoom</Company>
    <Product>Jocuri și Discuții</Product>
    <Description>Actualizatorul oficial pentru Jocuri și Discuții.</Description>
    <Copyright>Copyright © 2026 Cris GameRoom. Toate drepturile rezervate.</Copyright>
    <Authors>Cris GameRoom</Authors>
    <AssemblyInformationalVersion>1.0.14</AssemblyInformationalVersion>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
    <FileVersion>1.0.14.0</FileVersion>
    <Version>1.0.14</Version>
</PropertyGroup>
</Project>
