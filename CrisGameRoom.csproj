<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>JocuriSiDiscutii</AssemblyName>
    <RootNamespace>CrisGameRoom</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>CRIS GAMEROOM</Company>
    <Product>Jocuri și Discuții</Product>
    <Description>Aplicația nativă oficială Cris GameRoom pentru jocuri și discuții.</Description>
    <Copyright>Copyright © 2026 Cris GameRoom. Toate drepturile rezervate.</Copyright>
    <Authors>Cris GameRoom</Authors>
    <AssemblyInformationalVersion>1.0.13</AssemblyInformationalVersion>

    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <AssemblyVersion>1.0.13.0</AssemblyVersion>
    <FileVersion>1.0.13.0</FileVersion>
    <Version>1.0.13</Version></PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SocketIOClient" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CrisGameRoomUpdater/**/*.cs" />
    <None Remove="CrisGameRoomUpdater/**/*.cs" />
    <Content Remove="CrisGameRoomUpdater/**/*.cs" />
  </ItemGroup>
<ItemGroup>
    <EmbeddedResource Include="Localization/catalog.json" Link="Localization\catalog.json" LogicalName="CrisGameRoom.Localization.catalog.json" />
</ItemGroup>
</Project>
